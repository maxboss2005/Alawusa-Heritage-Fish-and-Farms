# Backend Environment Variables
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb://localhost:27017/alawusa-heritage
# OR for PostgreSQL:
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/alawusa_heritage

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Firebase (Service Account)
FIREBASE_PROJECT_ID=alawusa-heritage-website
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@alawusa-heritage-website.iam.gserviceaccount.com

# Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development
